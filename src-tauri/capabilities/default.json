{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities needed by the Upiqal main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:webview:allow-internal-toggle-devtools",
    "core:window:default",
    "shell:default",
    "shell:allow-execute",
    "shell:allow-spawn",
    {
      "identifier": "shell:allow-open",
      "allow": [{ "url": "https://**" }, { "url": "http://**" }]
    },
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-read-dir",
    "fs:allow-write-file",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-stat",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$PICTURE/**" },
        { "path": "$TEMP/**" },
        { "path": "/tmp/**" },
        { "path": "/var/folders/**" },
        { "path": "/Users/**" },
        { "path": "A:/**" },
        { "path": "B:/**" },
        { "path": "C:/**" },
        { "path": "D:/**" },
        { "path": "E:/**" },
        { "path": "F:/**" },
        { "path": "G:/**" },
        { "path": "H:/**" },
        { "path": "I:/**" },
        { "path": "J:/**" },
        { "path": "K:/**" },
        { "path": "L:/**" },
        { "path": "M:/**" },
        { "path": "N:/**" },
        { "path": "O:/**" },
        { "path": "P:/**" },
        { "path": "Q:/**" },
        { "path": "R:/**" },
        { "path": "S:/**" },
        { "path": "T:/**" },
        { "path": "U:/**" },
        { "path": "V:/**" },
        { "path": "W:/**" },
        { "path": "X:/**" },
        { "path": "Y:/**" },
        { "path": "Z:/**" },
        { "path": "/home/**" },
        { "path": "/mnt/**" },
        { "path": "/media/**" }
      ]
    }
  ]
}
