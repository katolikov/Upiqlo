{
  "name": "upiqlo",
  "private": true,
  "version": "0.1.0",
  "description": "Cross-platform desktop app wrapping the FR-IQA (UPIQAL) image-quality algorithm.",
  "workspaces": [
    "ui"
  ],
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:ui": "npm --workspace @upiqlo/ui run dev",
    "dev:engine": "bash scripts/dev-engine.sh",
    "tauri:dev": "cargo tauri dev --manifest-path src-tauri/Cargo.toml",
    "tauri:build": "cargo tauri build --manifest-path src-tauri/Cargo.toml",
    "build:ui": "npm --workspace @upiqlo/ui run build",
    "build:sidecar": "python engine/scripts/build_sidecar.py",
    "clean": "bash scripts/clean.sh"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1"
  }
}
